<script>
(function () {
  'use strict';

  /* Same projection definition the Android app uses: EPSG:3168, Kertau (RSO) / RSO Malaya. */
  proj4.defs('EPSG:3168', '+proj=omerc +no_uoff +lat_0=4 +lonc=102.25 +alpha=323.0257905 +gamma=323.130102361111 +k=0.99984 +x_0=804670.24 +y_0=0 +ellps=evrst69 +towgs84=-11,851,5,0,0,0,0 +units=m +no_defs +type=crs');
  const toRSO = (lat, lon) => proj4('EPSG:4326', 'EPSG:3168', [lon, lat]);   // -> [easting, northing]
  const toLL  = (e, n) => { const p = proj4('EPSG:3168', 'EPSG:4326', [e, n]); return [p[1], p[0]]; }; // -> [lat, lon]

  // Rough box around Peninsular Malaysia, only used to flag points far from the grid's intended area.
  const AREA = { s: 1.0, n: 7.0, w: 99.4, e: 104.8 };

  const $ = (s) => document.querySelector(s);
  const f = { e: $('#e'), n: $('#n'), lat: $('#lat'), lon: $('#lon') };
  const noteEl = $('#note');

  /* ---------- helpers ---------- */
  let toastTimer;
  function toast(msg) {
    const t = $('#toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('show'), 3600);
  }

  function parseNum(s) {
    const t = String(s).trim().replace(/[\s,]/g, '').replace(/m$/i, '');
    return /^[-+]?(\d+\.?\d*|\.\d+)$/.test(t) ? parseFloat(t) : NaN;
  }

  function setErr(group, msg) {
    $('#err-' + group).textContent = msg;
    const inputs = group === 'rso' ? [f.e, f.n] : [f.lat, f.lon];
    inputs.forEach((i) => i.setAttribute('aria-invalid', 'true'));
  }
  function clearErr() {
    ['rso', 'll'].forEach((g) => { $('#err-' + g).textContent = ''; });
    Object.values(f).forEach((i) => i.removeAttribute('aria-invalid'));
  }

  function setNote(text, warn) {
    noteEl.textContent = text;
    noteEl.classList.toggle('warn', !!warn);
  }

  async function copyText(text) {
    try { await navigator.clipboard.writeText(text); return true; }
    catch (_) {
      const ta = document.createElement('textarea');
      ta.value = text; ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;top:0;opacity:0';
      document.body.appendChild(ta); ta.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch (_) {}
      ta.remove();
      return ok;
    }
  }

  /* ---------- map ---------- */
  const map = L.map('map', { zoomSnap: 0.5, worldCopyJump: true });
  map.fitBounds([[1.1, 99.5], [6.9, 104.6]]);

  const OSM_ATTR = '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors';
  const ESRI_ATTR = 'Imagery: Esri, NASA, NGA, USGS | SLA, Esri, TomTom, Garmin, METI/NASA, USGS';
  const layers = {
    street: L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: OSM_ATTR }),
    sat: L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { maxZoom: 19, attribution: ESRI_ATTR })
  };

  let currentLayer = null;
  function useLayer(name) {
    if (!layers[name]) name = 'street';
    if (currentLayer) map.removeLayer(layers[currentLayer]);
    layers[name].addTo(map);
    currentLayer = name;
    document.querySelectorAll('.seg button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.layer === name)));
    try { localStorage.setItem('rsomap.layer', name); } catch (_) {}
  }
  let saved = null;
  try { saved = localStorage.getItem('rsomap.layer'); } catch (_) {}
  useLayer(saved || 'street');
  document.querySelectorAll('.seg button').forEach((b) => b.addEventListener('click', () => useLayer(b.dataset.layer)));

  // Street tiles are often refused when a page is opened straight from disk (no Referer is sent).
  let tileHintShown = false;
  layers.street.on('tileerror', () => {
    if (location.protocol === 'file:' && !tileHintShown) {
      tileHintShown = true;
      toast('Street tiles may be blocked when opened from a file. Try Satellite, or host this page.');
    }
  });

  new ResizeObserver(() => map.invalidateSize()).observe($('#map'));

  /* ---------- point + readout ---------- */
  const pinIcon = L.divIcon({ className: 'pin', html: '<span></span>', iconSize: [40, 40], iconAnchor: [20, 20] });
  let marker = null;

  function inArea(lat, lon) { return lat >= AREA.s && lat <= AREA.n && lon >= AREA.w && lon <= AREA.e; }

  function render(lat, lon, opts) {
    opts = opts || {};
    const rso = toRSO(lat, lon);
    const e = opts.keep ? opts.keep.e : rso[0];
    const n = opts.keep ? opts.keep.n : rso[1];
    f.e.value = e.toFixed(2);
    f.n.value = n.toFixed(2);
    f.lat.value = lat.toFixed(6);
    f.lon.value = lon.toFixed(6);
    clearErr();
    if (!inArea(lat, lon)) {
      setNote('This point is outside Peninsular Malaysia, the area the RSO grid is meant for. Treat the grid values as approximate.', true);
    } else {
      setNote(opts.note || '', false);
    }
    if (opts.hash !== false) {
      try { history.replaceState(null, '', '#' + lat.toFixed(6) + ',' + lon.toFixed(6)); } catch (_) {}
    }
  }

  function setPoint(lat, lon, opts) {
    opts = opts || {};
    const rso = toRSO(lat, lon);
    if (!isFinite(rso[0]) || !isFinite(rso[1])) {
      setErr('ll', 'This location cannot be converted to the RSO grid.');
      return false;
    }
    if (!marker) {
      marker = L.marker([lat, lon], { icon: pinIcon, draggable: true, keyboard: false }).addTo(map);
      marker.on('drag', (ev) => render(ev.latlng.lat, ev.latlng.lng, { hash: false }));
      marker.on('dragend', () => { const p = marker.getLatLng(); render(p.lat, p.lng); });
    } else {
      marker.setLatLng([lat, lon]);
    }
    render(lat, lon, opts);
    if (opts.zoom) map.setView([lat, lon], Math.max(map.getZoom(), opts.zoom));
    return true;
  }

  map.on('click', (ev) => { const p = ev.latlng.wrap(); setPoint(p.lat, p.lng); });

  /* ---------- forms ---------- */
  $('#form-rso').addEventListener('submit', (ev) => {
    ev.preventDefault();
    const e = parseNum(f.e.value), n = parseNum(f.n.value);
    if (isNaN(e) || isNaN(n)) { setErr('rso', 'Enter both Easting and Northing in metres, for example 413028.67 and 349467.04.'); return; }
    const ll = toLL(e, n);
    if (!isFinite(ll[0]) || !isFinite(ll[1]) || Math.abs(ll[0]) > 90 || Math.abs(ll[1]) > 180) {
      setErr('rso', 'These values do not land on Earth. Check the Easting and Northing.'); return;
    }
    setPoint(ll[0], ll[1], { zoom: 15, keep: { e: e, n: n } });
  });

  $('#form-ll').addEventListener('submit', (ev) => {
    ev.preventDefault();
    const lat = parseNum(f.lat.value), lon = parseNum(f.lon.value);
    if (isNaN(lat) || isNaN(lon)) { setErr('ll', 'Enter both Latitude and Longitude in decimal degrees, for example 3.1579 and 101.7117.'); return; }
    if (Math.abs(lat) > 90) { setErr('ll', 'Latitude must be between -90 and 90.'); return; }
    if (Math.abs(lon) > 180) { setErr('ll', 'Longitude must be between -180 and 180.'); return; }
    setPoint(lat, lon, { zoom: 15 });
  });

  // Pasting "a, b" or "a b" into the first field fills both fields and converts.
  function splitPair(text) {
    const t = text.trim();
    if (/^[-+]?\d{1,3}(,\d{3})+(\.\d+)?$/.test(t)) return null;      // a single number with thousands separators
    const m = t.match(/^([-+]?\d+(?:\.\d+)?)\s*[,;\s]\s*([-+]?\d+(?:\.\d+)?)$/);
    return m ? [m[1], m[2]] : null;
  }
  [['e', 'n', '#form-rso'], ['lat', 'lon', '#form-ll']].forEach(([a, b, formSel]) => {
    f[a].addEventListener('paste', (ev) => {
      const text = (ev.clipboardData || window.clipboardData).getData('text');
      const pair = splitPair(text);
      if (!pair) return;
      ev.preventDefault();
      f[a].value = pair[0];
      f[b].value = pair[1];
      const form = $(formSel);
      if (form.requestSubmit) form.requestSubmit();
      else form.dispatchEvent(new Event('submit', { cancelable: true }));
    });
  });

  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const isRso = btn.dataset.copy === 'rso';
      const a = isRso ? f.e.value.trim() : f.lat.value.trim();
      const b = isRso ? f.n.value.trim() : f.lon.value.trim();
      if (!a || !b) { toast('Nothing to copy yet. Tap the map to pick a point.'); return; }
      const ok = await copyText(a + ', ' + b);
      toast(ok ? (isRso ? 'Copied Easting and Northing' : 'Copied latitude and longitude') : 'Copy is blocked in this browser. Select the values and copy them by hand.');
    });
  });

  /* ---------- device location ---------- */
  const locateBtn = $('#locate');
  locateBtn.addEventListener('click', () => {
    if (!navigator.geolocation) { toast('This browser cannot provide your location.'); return; }
    locateBtn.classList.add('busy');
    navigator.geolocation.getCurrentPosition((pos) => {
      locateBtn.classList.remove('busy');
      const acc = Math.round(pos.coords.accuracy);
      setPoint(pos.coords.latitude, pos.coords.longitude, { zoom: 17, note: 'Your location, accurate to about ' + acc + ' m.' });
    }, (err) => {
      locateBtn.classList.remove('busy');
      const msg = {
        1: 'Location access was denied. Allow it for this page in your browser settings.',
        2: 'Your device could not work out its location. Try again outdoors.',
        3: 'Finding your location took too long. Try again.'
      }[err.code] || 'Could not get your location.';
      toast(location.protocol === 'file:' && err.code === 1 ? msg + ' Browsers often block location for pages opened from a file.' : msg);
    }, { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 });
  });

  /* ---------- start from a shared link ---------- */
  const h = location.hash.match(/^#(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)$/);
  if (h) {
    const lat = parseFloat(h[1]), lon = parseFloat(h[2]);
    if (Math.abs(lat) <= 90 && Math.abs(lon) <= 180) setPoint(lat, lon, { zoom: 15 });
  }
})();
</script>
</body>
</html>
