<style>
*{box-sizing:border-box}
:root{
  --paper:#F1F5F4;
  --sheet:#FFFFFF;
  --ink:#0E2330;
  --slate:#4A6470;
  --hair:#C6D3D5;
  --mark:#D3226F;
  --ui:'Instrument Sans',ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  --num:'Spline Sans Mono',ui-monospace,'SF Mono',Menlo,Consolas,monospace;
}
html,body{height:100%;margin:0;background:var(--paper);color:var(--ink);font:400 15px/1.45 var(--ui);-webkit-text-size-adjust:100%}
button,input{font:inherit;color:inherit}

.app{height:100vh;height:100dvh;display:flex;flex-direction:column}
.mapwrap{position:relative;flex:1 1 auto;min-height:0}
#map{position:absolute;inset:0;background:#dfe7e6;cursor:crosshair}
.leaflet-container{font-family:var(--ui)}
.leaflet-dragging #map,.leaflet-dragging .leaflet-container{cursor:grabbing}

/* Panel */
.panel{flex:0 0 auto;max-height:54vh;max-height:54dvh;overflow:auto;background:var(--paper);border-top:1px solid var(--hair);padding:12px 16px calc(14px + env(safe-area-inset-bottom,0px))}
.panel h1{margin:0;font-size:18px;line-height:1.2;font-weight:600;letter-spacing:-.005em}
.panel .sub{margin:2px 0 0;color:var(--slate);font-size:13px}
.group{margin-top:12px;padding-top:12px;border-top:1px solid var(--hair)}
.group h2{margin:0 0 8px;font-size:14px;font-weight:600}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.field{display:flex;flex-direction:column;gap:4px;min-width:0}
.field label{font-size:12.5px;font-weight:500;color:var(--slate)}
input{width:100%;height:44px;padding:0 10px;border:1px solid var(--hair);border-radius:4px;background:var(--sheet);font:500 16px var(--num);font-variant-numeric:tabular-nums;letter-spacing:-.01em}
input::placeholder{color:#93A4AB;font-weight:400}
.rso input{height:50px;font-size:clamp(17px,4.8vw,21px)}
input:focus-visible,.btn:focus-visible,.seg button:focus-visible,.fab:focus-visible{outline:2px solid var(--mark);outline-offset:1px}
input[aria-invalid="true"]{border-color:var(--mark)}
.actions{display:flex;gap:8px;margin-top:10px}
.btn{height:44px;padding:0 16px;border-radius:4px;border:1px solid var(--ink);background:var(--ink);color:#fff;font-weight:600;font-size:14.5px;cursor:pointer}
.btn.grow{flex:1}
.btn.quiet{background:transparent;color:var(--ink);border-color:var(--hair)}
.btn:hover{filter:brightness(1.15)}
.btn.quiet:hover{filter:none;border-color:var(--slate)}
.err{margin:8px 0 0;font-size:13px;color:#A3154F;min-height:0}
.err:empty{display:none}
.note{margin:12px 0 0;font-size:13px;color:var(--slate)}
.note:empty{display:none}
.note.warn{color:var(--ink);border-left:3px solid var(--mark);padding-left:10px}

/* Map overlays */
.seg{position:absolute;top:10px;right:10px;z-index:1000;display:flex;background:var(--paper);border:1px solid var(--hair);border-radius:6px;padding:2px;box-shadow:0 1px 4px rgba(14,35,48,.18)}
.seg button{height:34px;padding:0 12px;border:0;border-radius:4px;background:transparent;font-weight:500;font-size:14px;color:var(--slate);cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--ink);color:#fff}
.fab{position:absolute;right:10px;bottom:34px;z-index:1000;width:46px;height:46px;border-radius:6px;border:1px solid var(--hair);background:var(--paper);color:var(--ink);display:grid;place-items:center;cursor:pointer;box-shadow:0 1px 4px rgba(14,35,48,.18)}
.fab svg{width:24px;height:24px}
.fab.busy{color:var(--mark)}
.fab.busy svg{animation:pulse 1s ease-in-out infinite}
@keyframes pulse{50%{opacity:.35}}
.toast{position:absolute;top:58px;left:50%;transform:translateX(-50%);z-index:1200;max-width:min(92%,420px);padding:10px 14px;border-radius:6px;background:var(--ink);color:#fff;font-size:14px;box-shadow:0 2px 8px rgba(14,35,48,.3);opacity:0;pointer-events:none;transition:opacity .18s}
.toast.show{opacity:1}
.leaflet-bar{border:1px solid var(--hair)!important;box-shadow:0 1px 4px rgba(14,35,48,.18)!important;border-radius:6px!important;overflow:hidden}
.leaflet-bar a{color:var(--ink);background:var(--paper);border-bottom-color:var(--hair)}
.leaflet-touch .leaflet-bar a{width:34px;height:34px;line-height:34px}
.leaflet-control-attribution{font-size:11px}

/* Point marker: a survey reticle */
.pin{filter:drop-shadow(0 0 1px #fff) drop-shadow(0 0 1px #fff);cursor:grab}
.pin span{display:block;width:40px;height:40px;position:relative;
  background:
    linear-gradient(var(--mark),var(--mark)) center/2px 100% no-repeat,
    linear-gradient(var(--mark),var(--mark)) center/100% 2px no-repeat}
.pin span::before{content:"";position:absolute;left:50%;top:50%;width:18px;height:18px;margin:-9px 0 0 -9px;border:2.5px solid var(--mark);border-radius:50%;background:rgba(255,255,255,.55)}

@media (min-width:860px){
  .app{flex-direction:row-reverse}
  .panel{width:400px;max-height:none;border-top:0;border-right:1px solid var(--hair);padding:22px 24px}
  .panel h1{font-size:22px}
  .group{margin-top:20px;padding-top:18px}
  .rso input{font-size:21px}
}
@media (prefers-reduced-motion:reduce){.fab.busy svg{animation:none}.toast{transition:none}}
</style>
</head>
<body>
<noscript>This page needs JavaScript to run.</noscript>
<div class="app">
  <main class="mapwrap">
    <div id="map" aria-label="Map. Click or tap to choose a point."></div>
    <div class="seg" role="group" aria-label="Map style">
      <button type="button" data-layer="street" aria-pressed="true">Street</button>
      <button type="button" data-layer="sat" aria-pressed="false">Satellite</button>
    </div>
    <button type="button" class="fab" id="locate" aria-label="Go to my location" title="Go to my location">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="6.5"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/></svg>
    </button>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </main>

  <section class="panel" aria-label="Coordinates">
    <h1>RSO Map</h1>
    <p class="sub">Kertau RSO grid, Peninsular Malaysia (EPSG:3168)</p>

    <form class="group rso" id="form-rso" novalidate>
      <h2>RSO grid, metres</h2>
      <div class="row">
        <div class="field"><label for="e">Easting</label><input id="e" inputmode="decimal" autocomplete="off" placeholder="413028.67"></div>
        <div class="field"><label for="n">Northing</label><input id="n" inputmode="decimal" autocomplete="off" placeholder="349467.04"></div>
      </div>
      <div class="actions">
        <button class="btn grow" type="submit">Show on map</button>
        <button class="btn quiet" type="button" data-copy="rso">Copy</button>
      </div>
      <p class="err" id="err-rso" role="alert"></p>
    </form>

    <form class="group" id="form-ll" novalidate>
      <h2>Latitude and longitude, WGS 84</h2>
      <div class="row">
        <div class="field"><label for="lat">Latitude</label><input id="lat" inputmode="decimal" autocomplete="off" placeholder="3.157900"></div>
        <div class="field"><label for="lon">Longitude</label><input id="lon" inputmode="decimal" autocomplete="off" placeholder="101.711700"></div>
      </div>
      <div class="actions">
        <button class="btn grow" type="submit">Show on map</button>
        <button class="btn quiet" type="button" data-copy="ll">Copy</button>
      </div>
      <p class="err" id="err-ll" role="alert"></p>
    </form>

    <p class="note" id="note">Tap the map to read its RSO grid coordinates, or type coordinates above. Drag the marker to fine-tune.</p>
  </section>
</div>

